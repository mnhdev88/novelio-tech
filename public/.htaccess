Options -MultiViews
RewriteEngine On

# ── Canonical host + scheme: force https://www.noveliotech.com in ONE hop ───
# Every canonical tag points at https://www.noveliotech.com, so any other
# variant (http/https × www/non-www) must 301 there. Doing it in one combined
# rule avoids redirect CHAINS (e.g. http://apex → https://apex → https://www) —
# chains are what made GSC's "Page with redirect" validation fail. The old rule
# only caught the bare apex, so http://www.noveliotech.com was never forced to
# HTTPS. On Hostinger/LiteSpeed %{HTTPS} reflects the real scheme; behind a
# proxy, swap the 2nd cond for %{HTTP:X-Forwarded-Proto} !=https.
RewriteCond %{HTTP_HOST} !^www\.noveliotech\.com$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://www.noveliotech.com/$1 [R=301,L]

# ── 410 Gone — WooCommerce / WordPress-only junk, should never exist ────────
RewriteRule ^cart/?$                                              - [G,L]
RewriteRule ^my-account-2/?$                                     - [G,L]
RewriteRule ^product/.*$                                         - [G,L]
RewriteRule ^.*/feed/?$                                          - [G,L]

# ── 301 — old WordPress tag archives + blog archive → /blog ────────────────
RewriteRule ^tag/.*$                                             /blog [R=301,L]
RewriteRule ^blog-grid/?$                                        /blog [R=301,L]

# ── 301 — old PHP / HTML pages → React equivalents ─────────────────────────
RewriteRule ^index\.php$                                         / [R=301,L]
RewriteRule ^about\.php$                                         /about [R=301,L]
RewriteRule ^contact\.php$                                       /contact [R=301,L]
RewriteRule ^services\.php$                                      /services [R=301,L]
RewriteRule ^seo-services\.php$                                  /services/search-engine-optimization [R=301,L]
RewriteRule ^brand-building\.php$                                /services/branding [R=301,L]
RewriteRule ^target-lead-generation\.php$                        /services/lead-generation [R=301,L]
RewriteRule ^virtual-assistance\.php$                            /services/tech-ops [R=301,L]
RewriteRule ^bpo-services\.php$                                  /services [R=301,L]
RewriteRule ^business-process-outsourcing\.php$                  /services [R=301,L]
RewriteRule ^knowledge-process-outsourcing\.php$                 /services [R=301,L]
RewriteRule ^refund\.php$                                        /refund-policy [R=301,L]
RewriteRule ^policies\.php$                                      /privacy [R=301,L]
RewriteRule ^privacy\.php$                                       /privacy [R=301,L]
RewriteRule ^results\.html$                                      /about [R=301,L]
RewriteRule ^cdn-cgi/.*$                                         /contact [R=301,L]

# ── 301 — old WordPress page slugs ─────────────────────────────────────────
RewriteRule ^home/?$                                             / [R=301,L]
RewriteRule ^home-2/?$                                           / [R=301,L]

# ── 301 — renamed local landing page ───────────────────────────────────────
RewriteRule ^best-website-developer-newark-nj/?$                 /best-website-developer-in-newark [R=301,L]

# ── 301 — old WordPress blog posts → /blog ─────────────────────────────────
RewriteRule ^tips-for-remotely-managing-a-team-during-covid-19/?$         /blog [R=301,L]
RewriteRule ^10-rules-you-should-know-about-ux-writing/?$                 /blog [R=301,L]
RewriteRule ^how-to-get-the-most-out-of-your-press-release/?$             /blog [R=301,L]
RewriteRule ^9-tips-to-start-preparing-for-christmas-this-year/?$         /blog [R=301,L]
RewriteRule ^how-to-increase-your-youtube-subscribers/?$                  /blog [R=301,L]

# ── Serve prerendered static HTML at clean (no-trailing-slash) URLs ──────────
# If a prerendered <route>/index.html exists, serve it directly — no DirectorySlash
# 301 hop — so the delivered URL matches the page's canonical tag. Built by
# `npm run build:prerender` (scripts/prerender.mjs). Skipped for real files/assets.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ /$1/index.html [L]

# ── SPA fallback (must be last) ─────────────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]
