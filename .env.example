# Copy to .env and fill in. Vite inlines VITE_* vars at build time.

# Formspree form ID — https://formspree.io/
VITE_FORMSPREE_ID=your_form_id_here

# Novelio CRM API key — newsletter subscriptions
VITE_CRM_API_KEY=your_crm_api_key_here

# PayPal PUBLIC client id (safe in the browser). Blank = checkout stays in Demo mode.
# The PayPal SECRET is server-side only (novelio-paypal-credentials.php) — see PAYPAL-SETUP.md.
VITE_PAYPAL_CLIENT_ID=
# 'sandbox' while testing, 'live' when going real.
VITE_PAYPAL_ENV=sandbox

# ── Razorpay ────────────────────────────────────────────────────────────────
# PUBLIC Razorpay Key ID (safe in the browser — it's sent to every visitor).
# Blank = the Razorpay option is hidden entirely.
# The Key SECRET is server-side only (novelio-razorpay-credentials.php),
# as is the webhook secret — see RAZORPAY-SETUP.md.
VITE_RAZORPAY_KEY_ID=
# 'test' while using rzp_test_… keys, 'live' with rzp_live_… keys.
# Drives the sandbox banner only; the real environment is decided by the key.
VITE_RAZORPAY_ENV=test
# Offer USD on Razorpay as well as INR. Requires "International Payments" to be
# approved on the Razorpay account — leave blank and buyers see INR only.
VITE_RAZORPAY_USD_ENABLED=1
# GST added to INR payments, as a percentage. Must match RAZORPAY_GST_PERCENT
# in public/api/razorpay/_config.php — the server recomputes it either way.
VITE_GST_PERCENT=18
