# Copy to .env and fill in. Vite inlines VITE_* vars at build time.

# Formspree form ID — https://formspree.io/
VITE_FORMSPREE_ID=your_form_id_here

# Novelio CRM API key — newsletter subscriptions
VITE_CRM_API_KEY=your_crm_api_key_here

# PayPal PUBLIC client id (safe in the browser). Blank = checkout stays in Demo mode.
# The PayPal SECRET is server-side only (novelio-paypal-credentials.php) — see PAYPAL-SETUP.md.
VITE_PAYPAL_CLIENT_ID=
# 'sandbox' while testing, 'live' when going real.
VITE_PAYPAL_ENV=sandbox
